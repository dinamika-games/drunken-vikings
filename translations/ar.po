#. what a person says, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
msgid "Hedda! She jumps like a kid again. Here, the best cheese I have."
msgstr "هيدا! إنها تقفز مثل الجدي من جديد. {crew|خذْ|خذي|خذا}، أفضل جبن عندي."

#. what a person says, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
