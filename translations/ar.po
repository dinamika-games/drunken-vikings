#: scenes/chase/chase.gd
#, fuzzy
msgid "You made it!"
msgstr "لقد {crew|نجحتَ|نجحتِ|نجحتما}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid ""
"You reached {place} before the pirates! The people of {place} chase the pirates away, and give you"
" {silver} silver."
msgstr ""
"{crew|وصلتَ|وصلتِ|وصلتما} إلى {place} قبل القراصنة! يطرد أهل {place} القراصنة، "
"{crew|ويعطونكَ|ويعطونكِ|ويعطونكما} {silver|{silver} قطعة فضة|قطعة فضة واحدة|قطعتي فضة|{silver} قطع"
" فضة|{silver} قطعة فضة|{silver} قطعة فضة}."

#: scenes/chase/chase.gd
#, fuzzy
msgid "Caught!"
msgstr "أمسكوا {crew|بكَ|بكِ|بكما}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates caught you! They laugh, kiss the prow of your boat, and sail away. Try again?"
msgstr ""
"أمسك القراصنة {crew|بكَ|بكِ|بكما}! يضحكون، ويقبّلون مقدّمة {crew|قاربكَ|قاربكِ|قاربكما}، ثم يبحرون"
" بعيدًا. مرة أخرى؟"

#. the title of a card (a button): a word or two, at most two short lines
#: scenes/chase/chase.gd
#, fuzzy
msgid "Another chase!"
msgstr "مطاردة أخرى!"

#. the title of a card (a button): a word or two, at most two short lines
#: scenes/chase/chase.gd
#, fuzzy
msgid "To the start"
msgstr "إلى البداية"

#. the second line of a card (a button), under its title: a few words
#: scenes/chase/chase.gd
#, fuzzy
msgid "other games"
msgstr "ألعاب أخرى"

#. the title of a card (a button): a word or two, at most two short lines
#: scenes/chase/chase.gd scenes/level/level.gd scenes/world/port_screens.gd
#, fuzzy
msgid "Stop for today"
msgstr "كفى لليوم"

#. the second line of a card (a button), under its title: a few words
#: scenes/chase/chase.gd scenes/level/level.gd scenes/world/port_screens.gd
#, fuzzy
msgid "see you!"
msgstr "إلى اللقاء!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "Pirates! Row to {place} before they catch you!"
msgstr ""
"قراصنة! {crew|جدِّفْ|جدِّفي|جدِّفا} إلى {place} قبل أن {crew|يمسكوا بكَ|يمسكوا بكِ|يمسكوا بكما}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates are right behind you! Row, row!"
msgstr ""
"القراصنة {crew|خلفكَ|خلفكِ|خلفكما} تمامًا! {crew|جدِّفْ، جدِّفْ|جدِّفي، جدِّفي|جدِّفا، جدِّفا}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "Row to {place}!"
msgstr "{crew|جدِّفْ|جدِّفي|جدِّفا} إلى {place}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "{place}: {metres} m to go.   The pirates: {gap} m behind you."
msgstr "{place}: باقي {metres} م.   القراصنة: على بعد {gap} م {crew|خلفكَ|خلفكِ|خلفكما}."

#: scenes/game/farm.gd
#, fuzzy
msgid "{crop} is ripe in {days} {days|day|days}."
msgstr ""
"{crop}: يحين الحصاد بعد {days|{days} يوم|يوم واحد|يومين|{days} أيام|{days} يومًا|{days} يوم}."

#: scenes/game/farm.gd
#, fuzzy
msgid "{crop} is ripe: harvest within {days} {days|day|days}!"
msgstr ""
"{crop}: حان الحصاد! {crew|احصدْ|احصدي|احصدا} خلال {days|{days} يوم|يوم واحد|يومين|{days} "
"أيام|{days} يومًا|{days} يوم}!"

#: scenes/game/farm.gd
#, fuzzy
msgid "{crop} is ripe, the birds are eating it: harvest it now!"
msgstr "{crop}: حان الحصاد، والطيور تأكل الزرع! {crew|احصدْ|احصدي|احصدا} الآن!"

#: scenes/game/farm.gd
#, fuzzy
msgid "The {animals} are hungry: bring {good}!"
msgstr "{animals} جائعة: {crew|أحضِرْ|أحضري|أحضِرا} {good@acc}!"

#: scenes/game/farm.gd
#, fuzzy
msgid "The {animals} are hungry, so no {young}: bring {good}!"
msgstr "{animals} جائعة، فلا {young}: {crew|أحضِرْ|أحضري|أحضِرا} {good@acc}!"

#: scenes/game/farm.gd
#, fuzzy
msgid "No room for {young}: buy land!"
msgstr "لا مكان من أجل {young}: {crew|اشترِ|اشتري|اشتريا} أرضًا!"

#: scenes/game/farm.gd
#, fuzzy
msgid "The {good} lasts only {days} more {days|day|days}."
msgstr ""
"ما {crew|لديكَ|لديكِ|لديكما} من {good} يكفي {days|{days} يوم|يومًا واحدًا|يومين|{days} أيام|{days}"
" يومًا|{days} يوم} فقط."

#: scenes/game/gossip.gd
#, fuzzy
msgid "They pay {silver} silver for {good} in {place}! Bring them some."
msgstr ""
"في {place} يدفعون {silver|{silver} قطعة فضة|قطعة فضة واحدة|قطعتي فضة|{silver} قطع فضة|{silver} "
"قطعة فضة|{silver} قطعة فضة} مقابل {good}! {crew|أحضِرْ|أحضري|أحضِرا} لهم شيئًا منه."

#: scenes/game/gossip.gd
#, fuzzy
msgid "{good} costs only {silver} silver in {place}."
msgstr ""
"ثمن {good} في {place} {silver|{silver} قطعة فضة|قطعة فضة واحدة|قطعتا فضة|{silver} قطع فضة|{silver}"
" قطعة فضة|{silver} قطعة فضة} فقط."

#: scenes/game/gossip.gd
#, fuzzy
msgid "Don't bring {good} to {place}, they have plenty: only {silver} silver."
msgstr ""
"{crew|لا تُحضِرْ|لا تُحضري|لا تُحضِرا} {good@acc} إلى {place}، فعندهم الكثير منه: {silver|{silver}"
" قطعة فضة|قطعة فضة واحدة|قطعتا فضة|{silver} قطع فضة|{silver} قطعة فضة|{silver} قطعة فضة} فقط."

#: scenes/game/gossip.gd
#, fuzzy
msgid "{event} in {place}! They want {good} there."
msgstr "{event} في {place}! يريدون {good@acc} هناك."

#: scenes/game/gossip.gd
#, fuzzy
msgid "Your grandmother asked me to tell you: {reminder}"
msgstr "طلبت مني {crew|جدتكَ|جدتكِ|جدتكما} أن أقول {crew|لكَ|لكِ|لكما}: {reminder}"

#: scenes/game/gossip.gd
#, fuzzy
msgid "{person} in {place} is looking for help: {task}."
msgstr "{person} في {place} بحاجة إلى مساعدة: {task}."

#: scenes/game/gossip.gd
#, fuzzy
msgid "{person} in {place} builds ships: a {ship} carries {crates} crates, for {silver} silver!"
msgstr ""
"عند {person} في {place} تُبنى السفن: حمولة {ship} {crates|{crates} صندوق|صندوق "
"واحد|صندوقان|{crates} صناديق|{crates} صندوقًا|{crates} صندوق}، والثمن {silver|{silver} قطعة "
"فضة|قطعة فضة واحدة|قطعتا فضة|{silver} قطع فضة|{silver} قطعة فضة|{silver} قطعة فضة}!"

#: scenes/game/gossip.gd
#, fuzzy
msgid "Did you know? {fact}"
msgstr "هل {crew|تعرف|تعرفين|تعرفان}؟ {fact}"

#: scenes/game/gossip.gd
#, fuzzy
msgid "Fair winds to you! {fact}"
msgstr "رياح طيبة {crew|لكَ|لكِ|لكما}! {fact}"

#: scenes/game/gossip.gd
#, fuzzy
msgid "Swap a crate of your {good} for a crate of my {other}?"
msgstr "هل {crew|تبادلني|تبادلينني|تبادلانني} صندوق {good} بصندوق {other} عندي؟"

#: scenes/game/gossip.gd
#, fuzzy
msgid ""
"You carry {good}? I give you {silver} silver a crate for {count} {count|crate|crates}, right now."
msgstr ""
"{crew|أتحمل|أتحملين|أتحملان} {good@acc}؟ {crew|أعطيكَ|أعطيكِ|أعطيكما} {silver|{silver} قطعة "
"فضة|قطعة فضة واحدة|قطعتي فضة|{silver} قطع فضة|{silver} قطعة فضة|{silver} قطعة فضة} عن كل صندوق، "
"مقابل {count|{count} صندوق|صندوق واحد|صندوقين|{count} صناديق|{count} صندوقًا|{count} صندوق}، الآن "
"فورًا."

#: scenes/game/gossip.gd
#, fuzzy
msgid ""
"I have {count} {count|crate|crates} of {good}, {silver} silver each: cheaper than any market. Want"
" {count|it|them}?"
msgstr ""
"عندي {count|{count} صندوق|صندوق واحد|صندوقان|{count} صناديق|{count} صندوقًا|{count} صندوق} من "
"{good}، كل صندوق بـ{silver|{silver} قطعة فضة|قطعة فضة واحدة|قطعتي فضة|{silver} قطع فضة|{silver} "
"قطعة فضة|{silver} قطعة فضة}: أرخص من أي سوق. {crew|هل تشتري؟|هل تشترين؟|هل تشتريان؟}"

#: scenes/game/gossip.gd
#, fuzzy
msgid "You have no room or not enough silver."
msgstr "ليس {crew|لديكَ|لديكِ|لديكما} مكان أو فضة تكفي."

#: scenes/game/gossip.gd
#, fuzzy
msgid "You bought {count} {count|crate|crates} of {good}."
msgstr ""
"{crew|اشتريتَ|اشتريتِ|اشتريتما} {count|{count} صندوق|صندوق واحد|صندوقين|{count} صناديق|{count} "
"صندوقًا|{count} صندوق} من {good}."

#: scenes/game/gossip.gd
#, fuzzy
msgid "You sold {count} {count|crate|crates} for {silver} silver."
msgstr ""
"{crew|بعتَ|بعتِ|بعتما} {count|{count} صندوق|صندوق واحد|صندوقين|{count} صناديق|{count} "
"صندوقًا|{count} صندوق} مقابل {silver|{silver} قطعة فضة|قطعة فضة واحدة|قطعتي فضة|{silver} قطع "
"فضة|{silver} قطعة فضة|{silver} قطعة فضة}."

#: scenes/game/gossip.gd
#, fuzzy
msgid "You swapped {good} for {other}."
msgstr "{crew|بادلتَ|بادلتِ|بادلتما} {good@acc} مقابل {other}."

