#: data/missions/046_the_autumn_feast/mission.json data/missions/077_ale_for_two_inns/mission.json
#, fuzzy
msgid "{count|a barrel of ale|{count} barrels of ale}"
msgstr "{count|en tunna öl|{count} tunnor öl}"

#. the thing '{count|a barrel of ale|{count} barrels of ale}' for {thing@acc} in the translations:
#. the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the
