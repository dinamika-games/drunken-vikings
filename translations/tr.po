#: scenes/chase/chase.gd
#, fuzzy
msgid ""
"You reached {place} before the pirates! The people of {place} chase the pirates away, and give you"
" {silver} silver."
msgstr ""
"Korsanlardan önce {place@to} {crew|vardın|vardın|vardınız}! {place} halkı korsanları kovuyor ve "
"{crew|sana|sana|size} {silver} gümüş veriyor."

#: scenes/chase/chase.gd
#, fuzzy
msgid "Caught!"
msgstr "{crew|Yakalandın|Yakalandın|Yakalandınız}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates caught you! They laugh, kiss the prow of your boat, and sail away. Try again?"
msgstr ""
"Korsanlar {crew|seni|seni|sizi} yakaladı! Gülüyorlar, teknenin pruvasını öpüyorlar ve yelken açıp "
"gidiyorlar. Bir daha {crew|dener misin|dener misin|dener misiniz}?"

