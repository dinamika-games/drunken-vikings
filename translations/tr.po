#. what a person says, at most 6 lines
#: data/missions/038_a_proper_hold/mission.json
#, fuzzy
msgid "Planks of pine, split with wedges. Stack them well!"
msgstr "Kamayla yarılmış çam tahtalar. İyi {crew|istifle|istifle|istifleyin}!"

#. what a person says, at most 6 lines
#: data/missions/038_a_proper_hold/mission.json
