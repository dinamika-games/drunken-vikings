#: data/missions/003_eggs_for_the_inn/mission.json
#, fuzzy
msgid "Eggs for the Inn"
msgstr "Æg til kroen"

#. what the giver of a task asks, at most 6 lines
#: data/missions/003_eggs_for_the_inn/mission.json
#, fuzzy
msgid ""
"Our hens lay more eggs than we can eat. Gudrun at the inn in Vargvik pays well for them. Load two "
"crates of eggs from the store and bring them to her."
msgstr ""
"Vores høns lægger flere æg, end vi kan spise. Gudrun på kroen i Vargvik betaler godt for dem. Hent"
" to kasser æg fra lageret, og bring dem til hende."

#. what a person says, at most 6 lines
#: data/missions/003_eggs_for_the_inn/mission.json
#, fuzzy
msgid "Fresh eggs! The guests will have pancakes tomorrow. Here is your silver, and come again."
msgstr ""
"Friske æg! Gæsterne får pandekager i morgen. Her er {crew|dit|dit|jeres} sølv, og kom snart igen."

