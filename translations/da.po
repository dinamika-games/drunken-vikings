msgid "You made it!"
msgstr "{crew|Du|Du|I} klarede den!"

#: scenes/chase/chase.gd
#, fuzzy
msgid ""
"You reached {place} before the pirates! The people of {place} chase the pirates away, and give you"
" {silver} silver."
msgstr ""
"{crew|Du|Du|I} nåede {place} før piraterne! Folkene {place@in} jager piraterne væk og giver "
"{crew|dig|dig|jer} {silver} sølv."

#: scenes/chase/chase.gd
#, fuzzy
msgid "Caught!"
msgstr "Fanget!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates caught you! They laugh, kiss the prow of your boat, and sail away. Try again?"
