#: scenes/chase/chase.gd
#, fuzzy
msgid "Pirates! Row to {place} before they catch you!"
msgstr "Пираты! {crew|Плыви|Плыви|Плывите} {place@to}, пока они {crew|тебя|тебя|вас} не догнали!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates are right behind you! Row, row!"
msgstr "Пираты прямо за {crew|тобой|тобой|вами}! {crew|Греби, греби|Греби, греби|Гребите, гребите}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "Row to {place}!"
