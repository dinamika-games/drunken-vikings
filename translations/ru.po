#. e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain translation
#: data/missions/052_the_coughing_horse/mission.json
msgctxt "acc"
msgid "the syrup"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/052_the_coughing_horse/mission.json
#, fuzzy
msgid "Honey helps a sore throat, for horses as for people."
msgstr "Мёд помогает при больном горле — и лошадям, и людям."

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
msgid "The Lame Goat"
msgstr "Хромая коза"

#. what the giver of a task asks, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
msgid ""
"My best goat, Hedda, limps! A thorn, I think, but she won't let me look. Take her to Tova on "
"Laxön. She takes the room of a crate, and she butts!"
msgstr ""
"Моя лучшая коза, Хедда, хромает! Наверное, заноза, но она не даёт мне посмотреть. "
"{crew|Отвези|Отвези|Отвезите} её к Туве на Лаксён. Она занимает место одного ящика и бодается!"

#. what a person says, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
msgid "Hold her head, gently... There: a big thorn. Leave her with me tonight, with a herb wrap."
msgstr ""
"{crew|Держи|Держи|Держите} ей голову, осторожно... Вот: большая колючка. "
"{crew|Оставь|Оставь|Оставьте} её у меня на ночь, с травяной повязкой."

#. what a person says, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
msgid "Hedda! She jumps like a kid again. Here, the best cheese I have."
msgstr "Хедда! Она снова скачет, как козлёнок. Вот, мой лучший сыр."

#. what a person says, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
msgid "She walks well again. Take her home!"
msgstr "Она снова хорошо ходит. {crew|Отвези|Отвези|Отвезите} её домой!"

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
msgid "Hedda"
msgstr "Хедда"

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/053_the_lame_goat/mission.json
#, fuzzy
msgid "Hedda the goat"
