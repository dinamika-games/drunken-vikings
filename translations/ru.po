msgstr "{crew|Ты купил|Ты купила|Вы купили} {count} {count|ящик|ящика|ящиков} {good@gen}."

#: scenes/game/gossip.gd
#, fuzzy
msgid "You sold {count} {count|crate|crates} for {silver} silver."
msgstr ""
"{crew|Ты продал|Ты продала|Вы продали} {count} {count|ящик|ящика|ящиков} за {silver} серебра."

#: scenes/game/gossip.gd
