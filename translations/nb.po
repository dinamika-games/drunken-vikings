#. e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain translation
#: data/missions/047_the_tipsy_uncle/mission.json
msgctxt "acc"
msgid "Uncle Sven"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/047_the_tipsy_uncle/mission.json
#, fuzzy
msgid "The vikings loved songs and riddles; at a feast, everybody had to sing."
msgstr "Vikingene elsket sanger og gåter; på en fest måtte alle synge."

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/048_geese_for_the_market/mission.json
#, fuzzy
msgid "Geese for the Market"
msgstr "Gjess til markedet"

#. what the giver of a task asks, at most 6 lines
#: data/missions/048_geese_for_the_market/mission.json
#, fuzzy
msgid ""
"The geese of Frosttorp are the fattest on the lakes. I want six for the market! Each goose takes a"
" crate, and they honk all the way."
msgstr ""
"Gjessene i Frosttorp er de feteste på innsjøene. Jeg vil ha seks til markedet! Hver gås tar en "
"kasse, og de snadrer hele veien."

#. what a person says, at most 6 lines
#: data/missions/048_geese_for_the_market/mission.json
#, fuzzy
msgid "Six geese, and not one escaped! The market will be loud today."
msgstr "Seks gjess, og ikke én slapp unna! Det blir bråkete på markedet i dag."

#. what a person says, at most 6 lines
#: data/missions/048_geese_for_the_market/mission.json
#, fuzzy
msgid "Honk! Honk! Hold on to your hats, girls."
msgstr "Snadder! Snadder! Hold godt på luene, {crew|vennen|vennen|dere to|jenter}."

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/048_geese_for_the_market/mission.json
#, fuzzy
msgid "Goose"
msgstr "Gås"

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
