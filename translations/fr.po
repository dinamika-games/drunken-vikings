#: scenes/chase/chase.gd
#, fuzzy
msgid "You made it!"
msgstr "{crew|Tu as réussi|Tu as réussi|Vous avez réussi} !"

#: scenes/chase/chase.gd
#, fuzzy
msgid ""
"You reached {place} before the pirates! The people of {place} chase the pirates away, and give you"
" {silver} silver."
msgstr ""
"{crew|Tu es arrivé|Tu es arrivée|Vous êtes arrivés|Vous êtes arrivées} à {place} avant les "
"pirates ! Les gens de {place} chassent les pirates et {crew|te|te|vous} donnent {silver} "
"{silver|pièce|pièces} d'argent."

#: scenes/chase/chase.gd
#, fuzzy
msgid "Caught!"
msgstr "{crew|Attrapé|Attrapée|Attrapés|Attrapées} !"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates caught you! They laugh, kiss the prow of your boat, and sail away. Try again?"
msgstr ""
"Les pirates {crew|t'ont rattrapé|t'ont rattrapée|vous ont rattrapés|vous ont rattrapées} ! Ils "
"rient, font un bisou à la proue de {crew|ton|ton|votre} bateau et repartent. On recommence ?"

