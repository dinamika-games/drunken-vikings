msgstr "तुम्हारी यात्रा शुभ हो! {fact}"

#: scenes/game/gossip.gd
#, fuzzy
msgid "Swap a crate of your {good} for a crate of my {other}?"
msgstr "तुम्हारी {good@gen} वाली एक पेटी, मेरी {other@gen} वाली एक पेटी से बदलें?"

#: scenes/game/gossip.gd
#, fuzzy
msgid ""
"You carry {good}? I give you {silver} silver a crate for {count} {count|crate|crates}, right now."
msgstr ""
"तुम्हारे पास {good} है? {count} {count|पेटी|पेटियाँ} दो, हर पेटी के {silver} चाँदी, अभी के अभी!"

#: scenes/game/gossip.gd
#, fuzzy
msgid ""
"I have {count} {count|crate|crates} of {good}, {silver} silver each: cheaper than any market. Want"
" {count|it|them}?"
msgstr ""
"मेरे पास {good@gen} की {count} {count|पेटी है|पेटियाँ हैं}, हर एक {silver} चाँदी की: किसी भी "
"बाज़ार से सस्ती। चाहिए?"

#: scenes/game/gossip.gd
#, fuzzy
msgid "You have no room or not enough silver."
msgstr "तुम्हारे पास जगह नहीं, या चाँदी कम है।"

#: scenes/game/gossip.gd
#, fuzzy
msgid "You bought {count} {count|crate|crates} of {good}."
msgstr "तुमने {good@gen} की {count} {count|पेटी खरीदी|पेटियाँ खरीदीं}।"

#: scenes/game/gossip.gd
#, fuzzy
msgid "You sold {count} {count|crate|crates} for {silver} silver."
msgstr "तुमने {count} {count|पेटी|पेटियाँ} {silver} चाँदी में {count|बेची|बेचीं}।"

#: scenes/game/gossip.gd
#, fuzzy
msgid "You swapped {good} for {other}."
msgstr "अदला-बदली हुई: {good@gen} के बदले {other}।"

