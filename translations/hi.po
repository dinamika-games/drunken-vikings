#: scenes/chase/chase.gd
#, fuzzy
msgid "You made it!"
msgstr "तुम {crew|पहुँच गए|पहुँच गईं|पहुँच गए|पहुँच गईं}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid ""
"You reached {place} before the pirates! The people of {place} chase the pirates away, and give you"
" {silver} silver."
msgstr ""
"तुम डाकुओं से पहले {place} {crew|पहुँच गए|पहुँच गईं|पहुँच गए|पहुँच गईं}! {place} के लोग डाकुओं को "
"भगा देते हैं और तुम्हें {silver} चाँदी देते हैं।"

#: scenes/chase/chase.gd
#, fuzzy
msgid "Caught!"
msgstr "पकड़ लिया!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates caught you! They laugh, kiss the prow of your boat, and sail away. Try again?"
msgstr ""
"डाकुओं ने तुम्हें पकड़ लिया! वे हँसते हैं, तुम्हारी नाव का अगला सिरा चूमते हैं और चले जाते हैं। "
"फिर से कोशिश?"

#. the title of a card (a button): a word or two, at most two short lines
#: scenes/chase/chase.gd
#, fuzzy
msgid "Another chase!"
msgstr "एक और पीछा!"

#. the title of a card (a button): a word or two, at most two short lines
#: scenes/chase/chase.gd
#, fuzzy
msgid "To the start"
msgstr "शुरुआत पर"

#. the second line of a card (a button), under its title: a few words
#: scenes/chase/chase.gd
#, fuzzy
msgid "other games"
msgstr "दूसरे खेल"

#. the title of a card (a button): a word or two, at most two short lines
#: scenes/chase/chase.gd scenes/level/level.gd scenes/world/port_screens.gd
#, fuzzy
msgid "Stop for today"
msgstr "आज बस"

#. the second line of a card (a button), under its title: a few words
#: scenes/chase/chase.gd scenes/level/level.gd scenes/world/port_screens.gd
#, fuzzy
msgid "see you!"
msgstr "फिर मिलेंगे!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "Pirates! Row to {place} before they catch you!"
msgstr "डाकू! उनके पकड़ने से पहले {place} पहुँचो!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates are right behind you! Row, row!"
msgstr "डाकू ठीक तुम्हारे पीछे हैं! चलाओ, चलाओ!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "Row to {place}!"
msgstr "{place} चलो!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "{place}: {metres} m to go.   The pirates: {gap} m behind you."
msgstr "{place}: {metres} मी. बाक़ी।   डाकू: {gap} मी. पीछे।"

#: scenes/game/farm.gd
#, fuzzy
msgid "{crop} is ripe in {days} {days|day|days}."
msgstr "{crop}: {days} {days|दिन|दिन} में तैयार।"

#: scenes/game/farm.gd
#, fuzzy
msgid "{crop} is ripe: harvest within {days} {days|day|days}!"
msgstr "{crop} तैयार है: {days} {days|दिन|दिन} के अंदर काटो!"

#: scenes/game/farm.gd
#, fuzzy
msgid "{crop} is ripe, the birds are eating it: harvest it now!"
msgstr "{crop} तैयार है, चिड़ियाँ उसे खा रही हैं: अभी काटो!"

#: scenes/game/farm.gd
#, fuzzy
msgid "The {animals} are hungry: bring {good}!"
