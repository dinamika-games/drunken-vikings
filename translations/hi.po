#: scenes/game/farm.gd
#, fuzzy
msgid "The {animals} are hungry, so no {young}: bring {good}!"
msgstr "{animals} भूखी हैं, इसलिए {young} नहीं: {good} लाओ!"

#: scenes/game/farm.gd
#, fuzzy
msgid "No room for {young}: buy land!"
