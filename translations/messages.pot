msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/061_the_swarm/mission.json
msgid "When a hive gets too full, half the bees fly off with a new queen: a swarm."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/062_the_cracked_kiln/mission.json
msgid "The Cracked Kiln"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/062_the_cracked_kiln/mission.json
msgid ""
"My kiln cracked in the frost! To build a new one I need six baskets of clay from Ekvik and three "
"sacks of charcoal from Grim to fire it."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/062_the_cracked_kiln/mission.json
msgid "Clay again? Dagny must be building a castle!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/062_the_cracked_kiln/mission.json
msgid "The new kiln glows! My first pots from it are for you."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/062_the_cracked_kiln/mission.json
msgid "A potter's kiln is a small oven of clay, heated so hot that the pots glow."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/063_hay_for_alberga/mission.json
msgid "Hay for Ålberga"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/063_hay_for_alberga/mission.json
msgid ""
"So many lambs this spring! The ewes eat and eat, and my hay is gone. Bring me eight crates of hay "
"within two days."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/063_hay_for_alberga/mission.json
msgid "Eight crates! The ewes munch, and the lambs jump around. Take a fleece of the softest wool."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/063_hay_for_alberga/mission.json
msgid "A sheep eats about two kilograms of hay a day."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/064_the_ferrymans_last_trip/mission.json
msgid "The Ferryman's Last Trip"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/064_the_ferrymans_last_trip/mission.json
msgid ""
"Old Halvard says his bones are too old for the oars. He wants to live with his daughter in Solby. "
"Will you row him there? He has stories for the whole way."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/064_the_ferrymans_last_trip/mission.json
msgid "Father! Come in, your chair by the fire is ready. Thank you for bringing him."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/064_the_ferrymans_last_trip/mission.json
msgid ""
"Old Halvard: Two young skippers for an old ferryman! Did I ever tell you about the sea serpent?"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/064_the_ferrymans_last_trip/mission.json
#: data/missions/100_the_feast_at_the_farm/mission.json
msgid "Halvard"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/064_the_ferrymans_last_trip/mission.json
#: data/missions/100_the_feast_at_the_farm/mission.json
msgid "Old Halvard"
msgstr ""

#. the thing 'Old Halvard' for {thing@acc} in the translations: the accusative (the direct object),
#. e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain translation
#: data/missions/064_the_ferrymans_last_trip/mission.json
#: data/missions/100_the_feast_at_the_farm/mission.json
msgctxt "acc"
msgid "Old Halvard"
msgstr ""

#. a gift for a task: 'You get ...'
#: data/missions/064_the_ferrymans_last_trip/mission.json
msgid "all of Halvard's stories"
msgstr ""

#. the thing 'all of Halvard's stories' for {thing@acc} in the translations: the accusative (the
#. direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
#: data/missions/064_the_ferrymans_last_trip/mission.json
msgctxt "acc"
msgid "all of Halvard's stories"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/064_the_ferrymans_last_trip/mission.json
msgid "Old people lived with their children on the farm, and told the stories of the family."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/065_shearing_time/mission.json
msgid "Shearing Time"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/065_shearing_time/mission.json
msgid ""
"The sheep are shorn! Nine sacks of fleece for Sæunn the weaver. Nine are more than your boat "
"takes: two trips, or a clever packing."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/065_shearing_time/mission.json
msgid "Nine sacks! My looms will clatter all summer. Here is a bolt of cloth for you."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/065_shearing_time/mission.json
msgid "Soft and greasy. Your hands will be soft too!"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/065_shearing_time/mission.json
msgid "Fleece"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/065_shearing_time/mission.json
msgid "{count|a sack of fleece|{count} sacks of fleece}"
msgstr ""

#. the thing '{count|a sack of fleece|{count} sacks of fleece}' for {thing@acc} in the translations:
#. the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the
#. same as the plain translation
#: data/missions/065_shearing_time/mission.json
msgctxt "acc"
msgid "{count|a sack of fleece|{count} sacks of fleece}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/065_shearing_time/mission.json
msgid "Sheep were shorn with iron shears, or their wool was plucked when it came loose."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/066_the_chieftains_horse/mission.json
msgid "The Chieftain's Horse"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/066_the_chieftains_horse/mission.json
msgid ""
"My horse Grane will not eat, and he is sad. Bring Tova to look at him, and take her home after."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/066_the_chieftains_horse/mission.json
msgid "Tova: Just as I thought: a sore tooth. I file it smooth... There. Let him rest a night."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/066_the_chieftains_horse/mission.json
msgid "Not eating? Let me see his teeth."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/066_the_chieftains_horse/mission.json
msgid "Back on my island. You were good assistants: soon you heal on your own."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/066_the_chieftains_horse/mission.json
msgid "Grane eats like a wolf again! Take Tova home, with my thanks."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/066_the_chieftains_horse/mission.json
msgid "Horses' teeth grow all their life; sometimes they must be filed smooth."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "A Brooch for Thora"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/067_a_brooch_for_thora/mission.json
msgid ""
"I want a brooch like a dragon! Hrafn makes it, if he gets glass beads for the eyes from the "
"market. And it costs 15 silver: I have saved them."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "Green eyes for a dragon. Come back tomorrow."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "Green glass beads, from very far away. Small, but precious!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "It is beautiful! Here, Father gave me 30 silver for you, and two are extra."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "A dragon with green eyes, biting its tail. Careful, the pin is sharp!"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "Beads"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "the glass beads"
msgstr ""

#. the thing 'the glass beads' for {thing@acc} in the translations: the accusative (the direct
#. object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
#: data/missions/067_a_brooch_for_thora/mission.json
msgctxt "acc"
msgid "the glass beads"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "Brooch"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/067_a_brooch_for_thora/mission.json
