msgstr ""

#. the thing 'the brooch' for {thing@acc} in the translations: the accusative (the direct object),
#. e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain translation
#: data/missions/067_a_brooch_for_thora/mission.json
msgctxt "acc"
msgid "the brooch"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/067_a_brooch_for_thora/mission.json
msgid "Viking women wore two big brooches on their dresses, often with beads between them."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/068_the_ducklings/mission.json
msgid "The Ducklings"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/068_the_ducklings/mission.json
msgid ""
"We found seven ducklings in Stormvik harbour, without their mother! Grim says a duck with no "
"ducklings swims sadly in his swan cove. Can you bring them to her?"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/068_the_ducklings/mission.json
msgid "Look: the duck swims to them, and they all paddle after her in a line. Seven! Ha!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/068_the_ducklings/mission.json
msgid "Peep, peep! They are in a basket with some straw. Hurry!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/068_the_ducklings/mission.json
msgid "They found their mother? Hooray! You are the best."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/068_the_ducklings/mission.json
msgid "Ducklings"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/068_the_ducklings/mission.json
msgid "the basket of ducklings"
msgstr ""

#. the thing 'the basket of ducklings' for {thing@acc} in the translations: the accusative (the
#. direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
#: data/missions/068_the_ducklings/mission.json
msgctxt "acc"
msgid "the basket of ducklings"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/068_the_ducklings/mission.json
msgid "Ducklings follow the first one they see after hatching, usually their mother."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/069_fish_for_the_hunters/mission.json
msgid "Fish for the Hunters"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/069_fish_for_the_hunters/mission.json
msgid ""
"My hunters go north for the whole summer. They need dried fish: six crates. Bring them within "
"three days, before they leave."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/069_fish_for_the_hunters/mission.json
msgid ""
"Six crates! The hunters say: this fish tastes better than the bear meat. Ha! Here is your silver."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/069_fish_for_the_hunters/mission.json
msgid "Dried fish kept for years, and was the bread of the travellers."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/070_the_boat_procession/mission.json
msgid "The Boat Procession"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/070_the_boat_procession/mission.json
msgid ""
"Midsummer again! This year, all the boats row in a line with torches. Bring three crates of mead, "
"and four torches from Orm in Hallvik: your boat leads the line!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/070_the_boat_procession/mission.json
msgid "Mead for after the procession. Now the torches."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/070_the_boat_procession/mission.json
msgid "My best tar torches, from the ones you helped me make!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/070_the_boat_procession/mission.json
msgid ""
"Twenty boats in a line, and you in front, with the dragon head! The torches shine on the water. "
"The most beautiful night of the year."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/070_the_boat_procession/mission.json
msgid "Torch"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/070_the_boat_procession/mission.json
msgid "{count|a torch|{count} torches}"
msgstr ""

#. the thing '{count|a torch|{count} torches}' for {thing@acc} in the translations: the accusative
#. (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the
#. plain translation
#: data/missions/070_the_boat_procession/mission.json
msgctxt "acc"
msgid "{count|a torch|{count} torches}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/070_the_boat_procession/mission.json
msgid "At midsummer, the sun barely sets in the north: the night stays light."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/071_the_sunny_hill/mission.json
msgid "The Sunny Hill"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/071_the_sunny_hill/mission.json
msgid ""
"My old aunt Gerd moves to Solby, to her sister. She owns the sunny hill by your farm, and says: "
"whoever rows me and my chests gets the hill! She has three chests."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/071_the_sunny_hill/mission.json
msgid "Aunt Gerd's chests? Bring her too!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/071_the_sunny_hill/mission.json
msgid "Aunt Gerd: My chests! Careful, the blue one has my grandmother's spoons."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/071_the_sunny_hill/mission.json
msgid ""
"My sister! And my chests! You are good girls. The sunny hill is yours: plant something beautiful "
"on it."
msgstr ""

#. who speaks in a task
#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/071_the_sunny_hill/mission.json
