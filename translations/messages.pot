#. what a person says, at most 6 lines
#: data/missions/024_new_ribs_for_the_boat/mission.json
msgid "These oaks grew bent in the wind: just right for the ribs of a boat."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/024_new_ribs_for_the_boat/mission.json
msgid "Good iron. Now my wages."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/024_new_ribs_for_the_boat/mission.json
msgid "Done! New ribs, wider planks: your hold takes one more crate."
msgstr ""

