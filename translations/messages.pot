msgid "a bear friend in the woods"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/073_the_bear_comes_back/mission.json
msgid "Brown bears live alone in the woods, eat berries, roots, fish and, yes, honey."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/074_a_striped_sail/mission.json
msgid "A Striped Sail"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/074_a_striped_sail/mission.json
msgid ""
"Your boat has a dragon head, but no sail. I will weave you a little one, with red and white "
"stripes. Bring me six crates of wool, and give me two nights."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/074_a_striped_sail/mission.json
msgid "Now the looms clatter. Come back in two days!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/074_a_striped_sail/mission.json
msgid ""
"Red and white stripes, like the great ships! It is small, but on a windy day it helps your arms."
msgstr ""

#. a gift for a task: 'You get ...'
#: data/missions/074_a_striped_sail/mission.json
msgid "a striped sail"
msgstr ""

#. the thing 'a striped sail' for {thing@acc} in the translations: the accusative (the direct
#. object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
#: data/missions/074_a_striped_sail/mission.json
msgctxt "acc"
msgid "a striped sail"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/074_a_striped_sail/mission.json
msgid "A big viking sail took a weaver years; it was worth as much as the ship."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/075_the_widest_hold/mission.json
msgid "The Widest Hold"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/075_the_widest_hold/mission.json
msgid ""
"Last time, I promise! Six oak branches from Frosttorp, four boxes of rivets from Hrafn, and 40 "
"silver: your hold takes two more crates, whatever ship you row."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/075_the_widest_hold/mission.json
msgid "Rivets for Bjarne? He must love you two."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/075_the_widest_hold/mission.json
msgid ""
"Two more crates! Now your hold is the widest on the lakes. Now go and trade like the big ships."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/075_the_widest_hold/mission.json
msgid "Rivets"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/075_the_widest_hold/mission.json
msgid "{count|a box of rivets|{count} boxes of rivets}"
msgstr ""

#. the thing '{count|a box of rivets|{count} boxes of rivets}' for {thing@acc} in the translations:
#. the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the
#. same as the plain translation
#: data/missions/075_the_widest_hold/mission.json
msgctxt "acc"
msgid "{count|a box of rivets|{count} boxes of rivets}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/075_the_widest_hold/mission.json
msgid "A knarr was wide and deep, for the cargo; a longship was narrow and fast."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/076_a_wedding_at_frosttorp/mission.json
msgid "A Wedding at Frosttorp"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/076_a_wedding_at_frosttorp/mission.json
msgid ""
"My daughter Ingrid marries Arne's son Kol in Frosttorp! Row her there in your painted boat, with "
"her three chests of dowry. Within two days!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/076_a_wedding_at_frosttorp/mission.json
msgid "The dowry! Now the bride."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/076_a_wedding_at_frosttorp/mission.json
msgid "Linen, a loom and silver spoons: everything for a new home."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/076_a_wedding_at_frosttorp/mission.json
msgid "Here comes the bride! Kol is red as a beet. Come, the feast begins!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/076_a_wedding_at_frosttorp/mission.json
msgid "In the boat with the dragon head! Everybody will look at me."
msgstr ""

