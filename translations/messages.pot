#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/026_clay_for_the_potter/mission.json
msgid "Clay for the Potter"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/026_clay_for_the_potter/mission.json
msgid ""
"My island has no clay left! The best clay is on the shore of Ekvik. Bring me four baskets, and you"
" get two crates of my pots."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/026_clay_for_the_potter/mission.json
msgid "Grey, sticky clay from the shore. Heavy too!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/026_clay_for_the_potter/mission.json
msgid "Lovely clay! Squeeze it, smell it... Here are your pots, still warm from the kiln."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/026_clay_for_the_potter/mission.json
#: data/missions/062_the_cracked_kiln/mission.json
msgid "Clay"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/026_clay_for_the_potter/mission.json
#: data/missions/062_the_cracked_kiln/mission.json
msgid "{count|a basket of clay|{count} baskets of clay}"
msgstr ""

#. the thing '{count|a basket of clay|{count} baskets of clay}' for {thing@acc} in the translations:
#. the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the
#. same as the plain translation
#: data/missions/026_clay_for_the_potter/mission.json
#: data/missions/062_the_cracked_kiln/mission.json
msgctxt "acc"
msgid "{count|a basket of clay|{count} baskets of clay}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/026_clay_for_the_potter/mission.json
msgid "The vikings made pots of clay, but the best ones were carved of soapstone."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/027_bees_for_solby/mission.json
msgid "Bees for Solby"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/027_bees_for_solby/mission.json
msgid ""
"My apple trees bloom, but no bee visits them! Without bees, no apples. Buy a beehive from Alfhild "
"in Dimmberga and bring it to my orchard."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/027_bees_for_solby/mission.json
msgid "Listen to them hum! Now the flowers will become apples. Take these flowers for your farm."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/027_bees_for_solby/mission.json
msgid "Bees carry the pollen from flower to flower, so that the fruits grow."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/028_the_lost_lamb/mission.json
msgid "The Lost Lamb"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/028_the_lost_lamb/mission.json
msgid ""
"One of the lambs from the cold night is gone! The little one with the black ear. Ask Freya and "
"Liv, they paddle everywhere in their canoe."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/028_the_lost_lamb/mission.json
msgid "A lamb with a black ear? We saw one on Laxön, eating Tova's flowers!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/028_the_lost_lamb/mission.json
msgid "She swam over! Can you imagine? She is wet but well. Take her home."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/028_the_lost_lamb/mission.json
msgid "Black Ear! She runs to her mother. Keep the other lamb of that ewe: she likes you."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/028_the_lost_lamb/mission.json
msgid "Lamb"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/028_the_lost_lamb/mission.json
msgid "the lamb"
msgstr ""

#. the thing 'the lamb' for {thing@acc} in the translations: the accusative (the direct object),
#. e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain translation
#: data/missions/028_the_lost_lamb/mission.json
msgctxt "acc"
msgid "the lamb"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/028_the_lost_lamb/mission.json
msgid "Sheep can swim, but they do not like it: their wool gets heavy."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/029_herbs_for_the_lakes/mission.json
msgid "Herbs for the Lakes"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/029_herbs_for_the_lakes/mission.json
msgid ""
"Autumn comes, and the animals catch colds. Take my herbs to those who need them: two bundles to "
"the horse farm, two to the herders, two to Gudrun's inn."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/029_herbs_for_the_lakes/mission.json
msgid "Herbs from Tova! Now the cow and the calf stay well all winter."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/029_herbs_for_the_lakes/mission.json
msgid "All delivered? You are real helpers now. Take these herbs for your own animals."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/029_herbs_for_the_lakes/mission.json
msgid "Herbs"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/029_herbs_for_the_lakes/mission.json
msgid "{count|a bundle of herbs|{count} bundles of herbs}"
msgstr ""

#. the thing '{count|a bundle of herbs|{count} bundles of herbs}' for {thing@acc} in the
#. translations: the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty
#. if it is the same as the plain translation
#: data/missions/029_herbs_for_the_lakes/mission.json
msgctxt "acc"
msgid "{count|a bundle of herbs|{count} bundles of herbs}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/029_herbs_for_the_lakes/mission.json
msgid "Healers dried herbs in bundles under the roof, to have them all winter."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/030_the_mill_turns/mission.json
msgid "The Mill Turns"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/030_the_mill_turns/mission.json
msgid ""
"The harvest is in, and the mill wheel turns day and night! But the farmers are slow. Bring me six "
"crates of grain to grind."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/030_the_mill_turns/mission.json
msgid "Six crates! Listen to the stones grind. Bjarne says hello, and here is your share."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/030_the_mill_turns/mission.json
msgid "Most vikings ground their grain by hand with two stones; a water mill was a wonder."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/031_a_henhouse_full/mission.json
msgid "A Henhouse Full"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/031_a_henhouse_full/mission.json
msgid ""
"Eggs sell so well! Let us have six hens. Buy hens at the market in Kråkhamn or the farm of "
"Frosttorp, and bring them home."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/031_a_henhouse_full/mission.json
msgid "Six hens! Cluck, cluck, scratch, scratch. Do not forget: they eat grain."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/031_a_henhouse_full/mission.json
msgid "Viking hens were small and laid fewer eggs than ours, but every farm had some."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/032_honey_cakes/mission.json
msgid "Honey Cakes"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/032_honey_cakes/mission.json
msgid ""
"We want to sell honey cakes on the market! But we have no oven. Bring honey and grain to your "
"grandmother; she bakes them overnight, and you bring us the cakes."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/032_honey_cakes/mission.json
msgid "Honey! Now the grain."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/032_honey_cakes/mission.json
msgid "I bake them tonight. Come for them in the morning!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/032_honey_cakes/mission.json
msgid "Still warm. Do not eat them all on the way!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/032_honey_cakes/mission.json
msgid "They smell so good! Everybody comes to our stall. Here, half the silver is yours."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/032_honey_cakes/mission.json
msgid "Cakes"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/032_honey_cakes/mission.json
msgid "{count|a basket of honey cakes|{count} baskets of honey cakes}"
msgstr ""

#. the thing '{count|a basket of honey cakes|{count} baskets of honey cakes}' for {thing@acc} in the
#. translations: the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty
#. if it is the same as the plain translation
#: data/missions/032_honey_cakes/mission.json
msgctxt "acc"
msgid "{count|a basket of honey cakes|{count} baskets of honey cakes}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/032_honey_cakes/mission.json
msgid "Viking bread was flat and baked on hot stones; honey made it a treat."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/033_the_chieftains_feast/mission.json
msgid "The Chieftain's Feast"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/033_the_chieftains_feast/mission.json
msgid ""
"My daughter Thora turns twelve! A feast with the whole valley: bring me three crates of mead and "
"two of cheese, within three days."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/033_the_chieftains_feast/mission.json
msgid "The mead! The skalds will sing."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/033_the_chieftains_feast/mission.json
msgid "Cheese, mead, songs and a fire! Come in, sit by me: it is the best birthday ever."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/033_the_chieftains_feast/mission.json
msgid "A chieftain's hall had a long fire in the middle, and benches along the walls."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/034_the_ferrymans_tale/mission.json
msgid "The Ferryman's Tale"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/034_the_ferrymans_tale/mission.json
msgid ""
"Old Halvard told a story here last night: a hidden cove, where the swans of the lakes are born. He"
" says: ask the potter, the miller and the old man of Svanetorp."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/034_the_ferrymans_tale/mission.json
msgid "The cove? My grandmother said: it lies where the reeds grow tallest. Ask Astrid."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/034_the_ferrymans_tale/mission.json
msgid "Reeds? The tallest ones grow south, by Svanetorp. Go to Grim."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/034_the_ferrymans_tale/mission.json
msgid ""
"So you found my secret. Behind my farm, in the reeds: the swan cove. Look, the cygnets! Grey and "
"fluffy. Tell no one!"
msgstr ""

#. a gift for a task: 'You get ...'
#: data/missions/034_the_ferrymans_tale/mission.json
msgid "the secret of the swan cove"
msgstr ""

#. the thing 'the secret of the swan cove' for {thing@acc} in the translations: the accusative (the
#. direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
#: data/missions/034_the_ferrymans_tale/mission.json
msgctxt "acc"
msgid "the secret of the swan cove"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/034_the_ferrymans_tale/mission.json
msgid "Young swans are grey, not white; they are called cygnets."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/035_wool_for_the_winter_cloth/mission.json
msgid "Wool for the Winter Cloth"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/035_wool_for_the_winter_cloth/mission.json
msgid ""
"Everybody wants warm cloth for the winter, and my looms are hungry. Bring me four crates of wool, "
"and I give you a bolt of red cloth."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/035_wool_for_the_winter_cloth/mission.json
msgid "Clack, clack, goes the loom. Here: the reddest cloth I ever made, for you."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/035_wool_for_the_winter_cloth/mission.json
msgid "The women of a viking farm wove all the cloth: sails, clothes and blankets."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/036_flax_in_the_field/mission.json
msgid "Flax in the Field"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/036_flax_in_the_field/mission.json
msgid ""
"Linen is softer than wool on the skin. Plant flax on your farm! When it blooms blue and is ripe, "
"bring me two crates."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/036_flax_in_the_field/mission.json
msgid "Flax seed in the field. In a few days, it blooms blue."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/036_flax_in_the_field/mission.json
msgid "Your own flax! I will make you linen shirts, soft as a cloud."
msgstr ""

#. a gift for a task: 'You get ...'
#: data/missions/036_flax_in_the_field/mission.json
msgid "linen shirts"
msgstr ""

#. the thing 'linen shirts' for {thing@acc} in the translations: the accusative (the direct object),
#. e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain translation
#: data/missions/036_flax_in_the_field/mission.json
msgctxt "acc"
msgid "linen shirts"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/036_flax_in_the_field/mission.json
msgid "Flax was soaked, beaten and combed for weeks before it could be spun into linen."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/037_barley_for_the_brewer/mission.json
msgid "Barley for the Brewer"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/037_barley_for_the_brewer/mission.json
msgid ""
"Orm of Hallvik wants the biggest barrel of ale for the autumn feast. I need grain, five crates! "
"Bring them, and you get two crates of my ale."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/037_barley_for_the_brewer/mission.json
msgid "Into the water with it, let it sprout... In a week, the best ale of the lakes!"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/037_barley_for_the_brewer/mission.json
msgid "Ale was brewed from barley and water, often with herbs instead of hops."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/038_a_proper_hold/mission.json
msgid "A Proper Hold"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/038_a_proper_hold/mission.json
msgid ""
"You are real traders now: you need a real hold! Bring me eight planks from Frosttorp and two "
"crates of iron tools, and pay 20 silver. Then your hold takes two more crates."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/038_a_proper_hold/mission.json
msgid "Planks of pine, split with wedges. Stack them well!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/038_a_proper_hold/mission.json
msgid "Good iron! Now my wages."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/038_a_proper_hold/mission.json
msgid "Saw, plane, rivets... Look at her! Longer, wider, and room for two more crates."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/038_a_proper_hold/mission.json data/missions/055_the_great_hold/mission.json
msgid "Plank"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/038_a_proper_hold/mission.json data/missions/055_the_great_hold/mission.json
msgid "{count|a plank|{count} planks}"
msgstr ""

#. the thing '{count|a plank|{count} planks}' for {thing@acc} in the translations: the accusative
#. (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the
#. plain translation
#: data/missions/038_a_proper_hold/mission.json data/missions/055_the_great_hold/mission.json
msgctxt "acc"
msgid "{count|a plank|{count} planks}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/038_a_proper_hold/mission.json
msgid "Viking boats were built of overlapping planks, held with iron rivets."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/039_the_messengers_cold/mission.json
msgid "The Messenger's Cold"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/039_the_messengers_cold/mission.json
msgid ""
"Atchoo! I have a cold, and I must tell the smith, the horse farm and the herders about the autumn "
"feast at Hallvik. Can you do it today? Atchoo!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/039_the_messengers_cold/mission.json
msgid "The autumn feast? I will bring my best knives to show."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/039_the_messengers_cold/mission.json
msgid "We will come with all the horses! Tell Inga to drink hot honey water."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/039_the_messengers_cold/mission.json
msgid "A feast! I will bring my flute. Thank you!"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/039_the_messengers_cold/mission.json
msgid "Messengers rowed, rode and ran: news could cross a land in a few days."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/040_hay_for_frosttorp/mission.json
msgid "Hay for Frosttorp"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/040_hay_for_frosttorp/mission.json
msgid ""
"My hay meadow was flooded, and the cows are hungry! I need eight crates of hay. Your big boat can "
"do it in one trip."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/040_hay_for_frosttorp/mission.json
msgid "Moo! Listen to them, they are happy. You saved my winter. Take this cheese."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/040_hay_for_frosttorp/mission.json
msgid "Hay is dried grass; without enough of it, a farm could not keep its animals over winter."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/041_sigvors_cheese/mission.json
msgid "Sigvor's Cheese"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/041_sigvors_cheese/mission.json
msgid ""
"My goats gave so much milk this summer! I made four big wheels of cheese for Orm's autumn feast in"
" Hallvik, but my boat is full of goats. Will you carry them?"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/041_sigvors_cheese/mission.json
msgid "Sigvor's cheese! The guests will fight over it. Well, not fight: they will ask nicely."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/041_sigvors_cheese/mission.json
msgid "Roll them in gently. And no nibbling!"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/041_sigvors_cheese/mission.json
msgid "Cheese"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/041_sigvors_cheese/mission.json
msgid "{count|a wheel of cheese|{count} wheels of cheese}"
msgstr ""

#. the thing '{count|a wheel of cheese|{count} wheels of cheese}' for {thing@acc} in the
#. translations: the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty
#. if it is the same as the plain translation
#: data/missions/041_sigvors_cheese/mission.json
msgctxt "acc"
msgid "{count|a wheel of cheese|{count} wheels of cheese}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/041_sigvors_cheese/mission.json
msgid "Cheese keeps the milk of the summer for the winter."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/042_a_cow_of_our_own/mission.json
msgid "A Cow of Our Own"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/042_a_cow_of_our_own/mission.json
msgid ""
"With the east meadow, we have room for a cow at last! Buy one at the horse farm in Torsgården. A "
"cow is big, but she fits in your boat like a crate, if she stands still."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/042_a_cow_of_our_own/mission.json
msgid "Look at her big brown eyes! She will give us milk every day. Let us call her Rosa."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/042_a_cow_of_our_own/mission.json
msgid "Cows were the wealth of a farm: a family counted its riches in cows."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/043_pots_for_ekvik/mission.json
msgid "Pots for Ekvik"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/043_pots_for_ekvik/mission.json
msgid ""
"The fish soup! We cook it for the whole village, but our big pot cracked. Bring us three crates of"
" pots from the potter, please."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/043_pots_for_ekvik/mission.json
msgid "New pots! Tonight there is fish soup for everybody, and for you two the first bowl."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/043_pots_for_ekvik/mission.json
msgid "The cooking pot hung over the fire on a chain, and the soup simmered all day."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/044_ragnas_broken_oar/mission.json
msgid "Ragna's Broken Oar"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/044_ragnas_broken_oar/mission.json
msgid ""
"Ragna rowed out at dawn and is not back! I fear her oar broke. Find her on the lakes, then come "
"back and fetch the spare oar for her."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/044_ragnas_broken_oar/mission.json
msgid "Hello! Yes, my oar broke, and I drift with one. Tell Tor to give you the spare one!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/044_ragnas_broken_oar/mission.json
msgid "She is well? Thank the gods. Here is the oar: bring it to her!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/044_ragnas_broken_oar/mission.json
msgid "My oar! Now I can row again. Here, take some fish: the freshest on the lakes."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/044_ragnas_broken_oar/mission.json
msgid "Every viking boat carried spare oars: a broken oar was common."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/045_torches_for_the_dark/mission.json
msgid "Torches for the Dark"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/045_torches_for_the_dark/mission.json
msgid ""
"The nights grow long. The guests of the autumn feast need light: bring me tar for torches, two "
"pots from Ekvik, and two crates of flax for the wicks."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/045_torches_for_the_dark/mission.json
msgid "Tar for torches? They burn bright and long."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/045_torches_for_the_dark/mission.json
msgid "Tar and flax: now my torches will light up the whole bay!"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/045_torches_for_the_dark/mission.json
msgid "Viking torches were sticks wrapped in flax or cloth, soaked in tar or fat."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/046_the_autumn_feast/mission.json
msgid "The Autumn Feast"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/046_the_autumn_feast/mission.json
msgid ""
"The autumn feast is tomorrow! Knut's ale is ready, five barrels. Bring them from Lindtorp, and "
"bring three crates of fish for the soup too."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/046_the_autumn_feast/mission.json
msgid "The ale! Now the fish."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/046_the_autumn_feast/mission.json
msgid "The biggest batch I ever brewed! Five barrels for Orm."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/046_the_autumn_feast/mission.json
msgid "Ale, soup, torches, Sten's flute and Hrafn's knives! Everybody is here. Dance with us!"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/046_the_autumn_feast/mission.json data/missions/077_ale_for_two_inns/mission.json
msgid "{count|a barrel of ale|{count} barrels of ale}"
msgstr ""

#. the thing '{count|a barrel of ale|{count} barrels of ale}' for {thing@acc} in the translations:
#. the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the
#. same as the plain translation
#: data/missions/046_the_autumn_feast/mission.json data/missions/077_ale_for_two_inns/mission.json
msgctxt "acc"
msgid "{count|a barrel of ale|{count} barrels of ale}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/046_the_autumn_feast/mission.json
msgid "The autumn feast thanked the gods for the harvest, before the long winter."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/047_the_tipsy_uncle/mission.json
msgid "The Tipsy Uncle"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/047_the_tipsy_uncle/mission.json
msgid ""
"Uncle Sven of Frosttorp sang and danced all night, and now he can't find his way home! He is very "
"merry and a little wobbly. Row him home to Arne, please."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/047_the_tipsy_uncle/mission.json
msgid "Uncle Sven! Singing all the way, I hear? Come in, sleep it off. Thank you, girls!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/047_the_tipsy_uncle/mission.json
msgid "Uncle Sven: Ho ho! Two little vikings with a boat! Let us sing on the way!"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/047_the_tipsy_uncle/mission.json
msgid "Sven"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/047_the_tipsy_uncle/mission.json
msgid "Uncle Sven"
msgstr ""

#. the thing 'Uncle Sven' for {thing@acc} in the translations: the accusative (the direct object),
#. e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain translation
#: data/missions/047_the_tipsy_uncle/mission.json
msgctxt "acc"
msgid "Uncle Sven"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/047_the_tipsy_uncle/mission.json
msgid "The vikings loved songs and riddles; at a feast, everybody had to sing."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/048_geese_for_the_market/mission.json
msgid "Geese for the Market"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/048_geese_for_the_market/mission.json
msgid ""
"The geese of Frosttorp are the fattest on the lakes. I want six for the market! Each goose takes a"
" crate, and they honk all the way."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/048_geese_for_the_market/mission.json
msgid "Six geese, and not one escaped! The market will be loud today."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/048_geese_for_the_market/mission.json
msgid "Honk! Honk! Hold on to your hats, girls."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/048_geese_for_the_market/mission.json
msgid "Goose"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/048_geese_for_the_market/mission.json
msgid "{count|a goose|{count} geese}"
msgstr ""

#. the thing '{count|a goose|{count} geese}' for {thing@acc} in the translations: the accusative
#. (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the
#. plain translation
#: data/missions/048_geese_for_the_market/mission.json
msgctxt "acc"
msgid "{count|a goose|{count} geese}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/048_geese_for_the_market/mission.json
msgid "Geese were kept on viking farms for eggs, feathers and down for pillows."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/049_the_runestone/mission.json
msgid "The Runestone"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/049_the_runestone/mission.json
msgid ""
"I will raise a runestone for my mother. The stone comes from the quarry by Bergö, and the "
"runecarver needs iron chisels from the smith. The stone is so big, it takes three crates of room!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
msgid "Good chisels. Now the stone."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
msgid "The stone! The carver begins today."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
msgid "It is in three pieces, to fit in your boat. The carver joins them."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
msgid ""
"The runestone stands! It says: Eirik raised this stone for Gunnvor, his good mother. And at the "
"bottom, small: Ylva and Sigrid rowed it."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/049_the_runestone/mission.json
msgid "Stone"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/049_the_runestone/mission.json
msgid "{count|a piece of the stone|{count} pieces of the stone}"
msgstr ""

#. the thing '{count|a piece of the stone|{count} pieces of the stone}' for {thing@acc} in the
#. translations: the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty
#. if it is the same as the plain translation
#: data/missions/049_the_runestone/mission.json
msgctxt "acc"
msgid "{count|a piece of the stone|{count} pieces of the stone}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/049_the_runestone/mission.json
msgid "Runestones were raised for loved ones, and painted in bright colours."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/050_the_first_snow/mission.json
msgid "The First Snow"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/050_the_first_snow/mission.json
msgid ""
"Snowflakes! Winter is near. Our store needs feed for the animals: six crates of hay and four of "
"grain. Your hold takes eight: think how to row it!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/050_the_first_snow/mission.json
msgid "Hay for the sheep, the goats and Rosa. Now the grain."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/050_the_first_snow/mission.json
msgid "The store is full! Let the snow come. Come in, the soup is hot."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/050_the_first_snow/mission.json
msgid "In winter, the animals stayed in the barn for months and ate the hay of the summer."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/051_the_ice_breaks/mission.json
msgid "The Ice Breaks"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/051_the_ice_breaks/mission.json
msgid ""
"Hear that crack? The ice breaks: spring is here again! Row out and hail two boats: ask how "
"everybody got through the winter."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/051_the_ice_breaks/mission.json
msgid "Everybody is well! But Tova has asked for you all winter. Row to Laxön!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/051_the_ice_breaks/mission.json
msgid "A long winter! But the herring kept, thanks to your salt."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/051_the_ice_breaks/mission.json
msgid ""
"There you are! Spring is when the animals need us most. Will you be my apprentices, and learn to "
"heal?"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/051_the_ice_breaks/mission.json
msgid "When the ice broke in spring, the boats came out, and with them the news."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/052_the_coughing_horse/mission.json
msgid "The Coughing Horse"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/052_the_coughing_horse/mission.json
msgid ""
"Your first case as healers: Ragnfrid's old horse Bror coughs. Take him this syrup of thyme and "
"honey, then come back to me after a night, to hear how he is."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/052_the_coughing_horse/mission.json
msgid "Thyme and honey? Bror loves it. He licks the spoon!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/052_the_coughing_horse/mission.json
msgid "He slept the whole night and coughs no more. Tell Tova: her apprentices are good!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/052_the_coughing_horse/mission.json
msgid "Well done! You listened, you waited, you looked. That is healing."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/052_the_coughing_horse/mission.json
msgid "Syrup"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/052_the_coughing_horse/mission.json
msgid "the syrup"
msgstr ""

#. the thing 'the syrup' for {thing@acc} in the translations: the accusative (the direct object),
#. e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain translation
#: data/missions/052_the_coughing_horse/mission.json
msgctxt "acc"
msgid "the syrup"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/052_the_coughing_horse/mission.json
msgid "Honey helps a sore throat, for horses as for people."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/053_the_lame_goat/mission.json
msgid "The Lame Goat"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
msgid ""
"My best goat, Hedda, limps! A thorn, I think, but she won't let me look. Take her to Tova on "
"Laxön. She takes the room of a crate, and she butts!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
msgid "Hold her head, gently... There: a big thorn. Leave her with me tonight, with a herb wrap."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
msgid "Hedda! She jumps like a kid again. Here, the best cheese I have."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/053_the_lame_goat/mission.json
msgid "She walks well again. Take her home!"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/053_the_lame_goat/mission.json
msgid "Hedda"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/053_the_lame_goat/mission.json
msgid "Hedda the goat"
msgstr ""

#. the thing 'Hedda the goat' for {thing@acc} in the translations: the accusative (the direct
#. object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
#: data/missions/053_the_lame_goat/mission.json
msgctxt "acc"
msgid "Hedda the goat"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/053_the_lame_goat/mission.json
msgid "Goats climb anything: rocks, roofs, and sometimes boats."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/054_barley_in_spring/mission.json
msgid "Barley in Spring"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/054_barley_in_spring/mission.json
msgid ""
"The fields are dry: time to sow! Plant barley, and while it grows, sell two crates of eggs to Orm "
"in Hallvik to buy more seed."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/054_barley_in_spring/mission.json
msgid "The barley is sown. Now the sun and the rain do the work."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/054_barley_in_spring/mission.json
msgid "Eggs! I make my famous egg cake. Here, good silver for good eggs."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/054_barley_in_spring/mission.json
msgid "Barley was the most important grain of the north: for bread, porridge and ale."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/055_the_great_hold/mission.json
msgid "The Great Hold"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/055_the_great_hold/mission.json
msgid ""
"Now we make your boat great! Ten planks from Frosttorp, three crates of tools, and 30 silver. Then"
" she takes two more crates. Ten planks are more than you can carry at once."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/055_the_great_hold/mission.json
msgid "Planks again? Bjarne is building you a ship!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/055_the_great_hold/mission.json
msgid "Iron for the rivets. Now my wages."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/055_the_great_hold/mission.json
msgid ""
"Two more crates! And go and see Signe in Ekvik: she builds real ships, and my crates go with you "
"into any of them."
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/055_the_great_hold/mission.json
msgid "A knarr, the cargo ship of the vikings, could carry the load of twenty boats."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/056_bjorns_salt_run/mission.json
msgid "Bjørn's Salt Run"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/056_bjorns_salt_run/mission.json
msgid ""
"My boat leaks, and the fishers of Ekvik wait for salt! Take eight sacks for me from here to Ekvik."
" Your new hold is just right."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/056_bjorns_salt_run/mission.json
msgid "Bjørn's salt, brought by you? Then I pay you, not him. Ha!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/056_bjorns_salt_run/mission.json
msgid "Eight sacks of the best salt from the sea. Keep them dry!"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/056_bjorns_salt_run/mission.json
msgid "Salt"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/056_bjorns_salt_run/mission.json
msgid "{count|a sack of salt|{count} sacks of salt}"
msgstr ""

#. the thing '{count|a sack of salt|{count} sacks of salt}' for {thing@acc} in the translations: the
#. accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same
#. as the plain translation
#: data/missions/056_bjorns_salt_run/mission.json
msgctxt "acc"
msgid "{count|a sack of salt|{count} sacks of salt}"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/056_bjorns_salt_run/mission.json
msgid "Salt was boiled out of sea water in big pans, and traded far inland."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/057_eggs_for_the_spring_feast/mission.json
msgid "Eggs for the Spring Feast"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/057_eggs_for_the_spring_feast/mission.json
msgid ""
"The spring feast! The children paint eggs and hide them in the grass. I need six crates of eggs. "
"Your hens are busy, I hope!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/057_eggs_for_the_spring_feast/mission.json
msgid "Ivar and Märta paint them red and yellow already. Come and help us hide them!"
msgstr ""

#. a fun fact at the end of a task, 2 short sentences
#: data/missions/057_eggs_for_the_spring_feast/mission.json
msgid "Eggs were a sign of spring and new life long before the Christian Easter."
msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/058_colours_for_the_boat/mission.json
msgid "Colours for the Boat"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/058_colours_for_the_boat/mission.json
msgid ""
"A great boat needs colours! Bring me three pots of paint from Dagny, and I paint your boat red and"
" blue, with a dragon head on the prow."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/058_colours_for_the_boat/mission.json
msgid "Red ochre, blue woad and white chalk, ground fine in linseed oil."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/058_colours_for_the_boat/mission.json
msgid ""
"One night of painting. Look: red and blue stripes, and a dragon head with golden eyes. Everybody "
"will know your boat!"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/058_colours_for_the_boat/mission.json
msgid "Paint"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
