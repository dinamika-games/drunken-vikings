msgid "{count|a pot of honey|{count} pots of honey}"
msgstr ""

#. a gift for a task: 'You get ...'
#: data/missions/073_the_bear_comes_back/mission.json
msgid "a bear friend in the woods"
msgstr ""

#. the thing 'a bear friend in the woods' for {thing@acc} in the translations: the accusative (the
#. direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
