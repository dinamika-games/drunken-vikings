msgstr ""

#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/061_the_swarm/mission.json
msgid "The Swarm"
msgstr ""

#. what the giver of a task asks, at most 6 lines
#: data/missions/061_the_swarm/mission.json
msgid ""
"My bees swarmed! A whole cloud of them flew off with a young queen, and Solveig says they hang in "
"her apple tree. Bring them this empty hive, and bring them back to me."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/061_the_swarm/mission.json
msgid "They hang there like a big brown pear! Hold the hive under them... shake... they are in!"
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/061_the_swarm/mission.json
msgid "My bees! Not one sting for you? Then they like you. Take two crates of honey."
msgstr ""

#. what a person says, at most 6 lines
#: data/missions/061_the_swarm/mission.json
msgid "Row smoothly: a swarm is calm, as long as nobody bumps the hive."
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/061_the_swarm/mission.json
msgid "Hive"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/061_the_swarm/mission.json
msgid "the empty hive"
msgstr ""

#. the thing 'the empty hive' for {thing@acc} in the translations: the accusative (the direct
#. object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
#: data/missions/061_the_swarm/mission.json
msgctxt "acc"
msgid "the empty hive"
msgstr ""

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/061_the_swarm/mission.json
msgid "Swarm"
msgstr ""

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/061_the_swarm/mission.json
msgid "the hive with the swarm"
msgstr ""

#. the thing 'the hive with the swarm' for {thing@acc} in the translations: the accusative (the
#. direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty if it is the same as the plain
#. translation
#: data/missions/061_the_swarm/mission.json
