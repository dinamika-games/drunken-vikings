#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "The Runestone"
msgstr "Der Runenstein"

#. what the giver of a task asks, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid ""
"I will raise a runestone for my mother. The stone comes from the quarry by Bergö, and the "
"runecarver needs iron chisels from the smith. The stone is so big, it takes three crates of room!"
msgstr ""
"Ich will einen Runenstein für meine Mutter aufstellen. Der Stein kommt aus dem Steinbruch bei "
"Bergö, und der Runenritzer braucht eiserne Meißel vom Schmied. Der Stein ist so groß, dass er den "
"Platz von drei Kisten braucht!"

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "Good chisels. Now the stone."
msgstr "Gute Meißel. Jetzt den Stein."

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "The stone! The carver begins today."
msgstr "Der Stein! Der Ritzer fängt heute an."

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "It is in three pieces, to fit in your boat. The carver joins them."
msgstr ""
"Er ist in drei Stücke geteilt, damit er in {crew|dein|dein|euer} Boot passt. Der Ritzer fügt sie "
"zusammen."

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid ""
"The runestone stands! It says: Eirik raised this stone for Gunnvor, his good mother. And at the "
"bottom, small: Ylva and Sigrid rowed it."
msgstr ""
"Der Runenstein steht! Darauf steht: Eirik stellte diesen Stein für Gunnvor auf, seine gute Mutter."
" Und ganz unten, klein: Ylva und Sigrid haben ihn gerudert."

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "Stone"
msgstr "Stein"

#. a thing of a task; {count|...|...} picks the form for the number {count} (one, then the others;
#. see the Plural-Forms of this file for how many forms your language has), e.g., '{count|a crate of
#. salt|{count} crates of salt}'
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "{count|a piece of the stone|{count} pieces of the stone}"
msgstr "{count|ein Stück vom Stein|{count} Stücke vom Stein}"

#. the thing '{count|a piece of the stone|{count} pieces of the stone}' for {thing@acc} in the
#. translations: the accusative (the direct object), e.g. 'бочку эля', 'bačvu piva'; leave it empty
#. if it is the same as the plain translation
#: data/missions/049_the_runestone/mission.json
msgctxt "acc"
msgid "{count|a piece of the stone|{count} pieces of the stone}"
