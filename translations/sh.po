#: data/missions/020_fog_on_the_lakes/mission.json
#, fuzzy
msgid ""
"A fog has fallen, and my children Ivar and Märta rowed out to the islands this morning! Old "
"Halvard knows the islands best. Please find them!"
msgstr ""
"Pala je magla, a moja djeca Ivar i Märta jutros su otveslala do otoka! Stari Halvard najbolje "
"poznaje otoke. Molim {crew|te|te|vas}, {crew|nađi|nađi|nađite} ih!"

#. what a person says, at most 6 lines
#: data/missions/020_fog_on_the_lakes/mission.json
#, fuzzy
msgid ""
"In this fog? Listen... I heard children's voices by Bergö, the island of the potter. Row there, "
"slowly!"
msgstr ""
"Po ovoj magli? {crew|Slušaj|Slušaj|Slušajte}... Kod Bergö se čuju dječji glasovi, na otoku "
"lončarice. {crew|Veslaj|Veslaj|Veslajte} tamo, polako!"

#. what a person says, at most 6 lines
#: data/missions/020_fog_on_the_lakes/mission.json
#, fuzzy
