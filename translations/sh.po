#, fuzzy
msgid "You made it!"
msgstr "{crew|Uspio si|Uspjela si|Uspjeli ste|Uspjele ste}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid ""
"You reached {place} before the pirates! The people of {place} chase the pirates away, and give you"
" {silver} silver."
msgstr ""
"{crew|Stigao si|Stigla si|Stigli ste|Stigle ste} {place@to} prije gusara! Ljudi {place@from} "
"tjeraju gusare i {crew|daju ti|daju ti|daju vam} {silver} "
"{silver|srebrnjak|srebrnjaka|srebrnjaka}."

#: scenes/chase/chase.gd
#, fuzzy
msgid "Caught!"
msgstr "{crew|Uhvaćen si|Uhvaćena si|Uhvaćeni ste|Uhvaćene ste}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates caught you! They laugh, kiss the prow of your boat, and sail away. Try again?"
msgstr ""
"Gusari su {crew|te|te|vas} uhvatili! Smiju se, poljube pramac {crew|tvog|tvog|vašeg} čamca i "
"otplove. Još jednom?"

