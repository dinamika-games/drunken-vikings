#. the title of a task, also on its card (a button): a few words, at most two short lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "The Runestone"
msgstr "Runski kamen"

#. what the giver of a task asks, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid ""
"I will raise a runestone for my mother. The stone comes from the quarry by Bergö, and the "
"runecarver needs iron chisels from the smith. The stone is so big, it takes three crates of room!"
msgstr ""
"Podići ću runski kamen za svoju majku. Kamen dolazi iz kamenoloma kraj Bergö, a klesaru trebaju "
"željezna dlijeta od kovača. Kamen je tako velik da zauzima mjesto za tri sanduka!"

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "Good chisels. Now the stone."
msgstr "Dobra dlijeta. Sad kamen."

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "The stone! The carver begins today."
msgstr "Kamen! Klesar počinje danas."

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "It is in three pieces, to fit in your boat. The carver joins them."
msgstr "U tri je komada, da stane u {crew|tvoj|tvoj|vaš} čamac. Klesar će ih spojiti."

#. what a person says, at most 6 lines
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid ""
"The runestone stands! It says: Eirik raised this stone for Gunnvor, his good mother. And at the "
"bottom, small: Ylva and Sigrid rowed it."
msgstr ""
"Runski kamen stoji! Piše: Eirik je podigao ovaj kamen za Gunnvor, svoju dobru majku. A na dnu, "
"sitno: dovezle su ga Ylva i Sigrid."

#. a thing of a task, under its crate: at most 10 letters
#: data/missions/049_the_runestone/mission.json
#, fuzzy
msgid "Stone"
msgstr "Kamen"

