#: scenes/game/gossip.gd
#, fuzzy
msgid "They pay {silver} silver for {good} in {place}! Bring them some."
msgstr "Në {place} paguajnë {silver} argjend për {good@acc}! {crew|Çoju|Çoju|Çojuni} pak."

#: scenes/game/gossip.gd
#, fuzzy
msgid "{good} costs only {silver} silver in {place}."
msgstr "Në {place} një arkë me {good@acc} kushton vetëm {silver} argjend."

#: scenes/game/gossip.gd
#, fuzzy
msgid "Don't bring {good} to {place}, they have plenty: only {silver} silver."
