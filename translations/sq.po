#: scenes/chase/chase.gd
#, fuzzy
msgid "You made it!"
msgstr "{crew|Ia dole|Ia dole|Ia dolët}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid ""
"You reached {place} before the pirates! The people of {place} chase the pirates away, and give you"
" {silver} silver."
msgstr ""
"{crew|Arrite|Arrite|Arritët} në {place} para piratëve! Njerëzit atje i dëbojnë piratët dhe "
"{crew|të japin|të japin|ju japin} {silver} argjend."

#: scenes/chase/chase.gd
#, fuzzy
msgid "Caught!"
msgstr "{crew|Të kapën|Të kapën|Ju kapën}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates caught you! They laugh, kiss the prow of your boat, and sail away. Try again?"
msgstr ""
"Piratët {crew|të kapën|të kapën|ju kapën}! Ata qeshin, puthin bashin e barkës dhe largohen. "
"{crew|Provon|Provon|Provoni} përsëri?"

#. the title of a card (a button): a word or two, at most two short lines
#: scenes/chase/chase.gd
#, fuzzy
msgid "Another chase!"
msgstr "Edhe një ndjekje!"

#. the title of a card (a button): a word or two, at most two short lines
#: scenes/chase/chase.gd
#, fuzzy
msgid "To the start"
msgstr "Në fillim"

#. the second line of a card (a button), under its title: a few words
#: scenes/chase/chase.gd
#, fuzzy
