#: scenes/game/gossip.gd
#, fuzzy
msgid "Did you know? {fact}"
msgstr "{crew|A e di|A e di|A e dini}? {fact}"

#: scenes/game/gossip.gd
#, fuzzy
msgid "Fair winds to you! {fact}"
msgstr "Erë të mbarë! {fact}"

#: scenes/game/gossip.gd
#, fuzzy
msgid "Swap a crate of your {good} for a crate of my {other}?"
msgstr ""
"{crew|Më jep|Më jep|Më jepni} një arkë me {good@acc}, e {crew|të jap|të jap|ju jap} një arkë me "
"{other@acc}?"

#: scenes/game/gossip.gd
#, fuzzy
msgid ""
"You carry {good}? I give you {silver} silver a crate for {count} {count|crate|crates}, right now."
msgstr ""
"{crew|Ke|Ke|Keni} {good@acc}? {crew|Të jap|Të jap|Ju jap} {silver} argjend për arkë, për {count} "
"{count|arkë|arka}, menjëherë."

#: scenes/game/gossip.gd
#, fuzzy
msgid ""
"I have {count} {count|crate|crates} of {good}, {silver} silver each: cheaper than any market. Want"
" {count|it|them}?"
msgstr ""
"Kam {count} {count|arkë|arka} me {good@acc}, {silver} argjend secila: më lirë se në çdo treg. "
"{count|E|I} {crew|do|do|doni}?"

#: scenes/game/gossip.gd
#, fuzzy
msgid "You have no room or not enough silver."
msgstr "Nuk {crew|ke|ke|keni} vend ose argjend të mjaftueshëm."

#: scenes/game/gossip.gd
#, fuzzy
msgid "You bought {count} {count|crate|crates} of {good}."
msgstr "{crew|Bleve|Bleve|Bletë} {count} {count|arkë|arka} me {good@acc}."

#: scenes/game/gossip.gd
#, fuzzy
msgid "You sold {count} {count|crate|crates} for {silver} silver."
msgstr "{crew|Shite|Shite|Shitët} {count} {count|arkë|arka} për {silver} argjend."

#: scenes/game/gossip.gd
#, fuzzy
msgid "You swapped {good} for {other}."
