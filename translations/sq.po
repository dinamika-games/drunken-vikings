#, fuzzy
msgid "{crop} is ripe in {days} {days|day|days}."
msgstr "Ara me {crop} piqet pas {days} {days|dite|ditësh}."

#: scenes/game/farm.gd
#, fuzzy
msgid "{crop} is ripe: harvest within {days} {days|day|days}!"
msgstr "Ara me {crop} u poq: {crew|korre|korre|korreni} brenda {days} {days|dite|ditësh}!"

#: scenes/game/farm.gd
#, fuzzy
msgid "{crop} is ripe, the birds are eating it: harvest it now!"
