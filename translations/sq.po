#: data/missions/007_the_swan_in_the_net/mission.json
#, fuzzy
msgid "For a swan? Take my best shears, and bring them back some day."
msgstr ""
"Për një mjellmë? {crew|Merri|Merri|Merrini} gërshërët e mia më të mira dhe {crew|m'i kthe|m'i "
"kthe|m'i ktheni} ndonjë ditë."

