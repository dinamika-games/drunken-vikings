#: scenes/chase/chase.gd
#, fuzzy
msgid "Pirates! Row to {place} before they catch you!"
msgstr ""
"Piratë! {crew|Vozit|Vozit|Vozitni} në {place} para se {crew|të të kapin|të të kapin|t'ju kapin}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "The pirates are right behind you! Row, row!"
msgstr "Piratët janë pas {crew|teje|teje|jush}! {crew|Vozit, vozit|Vozit, vozit|Vozitni, vozitni}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "Row to {place}!"
msgstr "{crew|Vozit|Vozit|Vozitni} në {place}!"

#: scenes/chase/chase.gd
#, fuzzy
msgid "{place}: {metres} m to go.   The pirates: {gap} m behind you."
msgstr "{place}: edhe {metres} m.   Piratët: {gap} m pas {crew|teje|teje|jush}."

