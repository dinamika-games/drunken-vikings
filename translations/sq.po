msgstr "Gjyshja më tha {crew|të të|të të|t'ju} them: {reminder}"

#: scenes/game/gossip.gd
#, fuzzy
msgid "{person} in {place} is looking for help: {task}."
msgstr "{person} në {place} kërkon ndihmë: {task}."

