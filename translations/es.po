#. what the giver of a task asks, at most 6 lines
#: data/missions/036_flax_in_the_field/mission.json
#, fuzzy
msgid ""
"Linen is softer than wool on the skin. Plant flax on your farm! When it blooms blue and is ripe, "
"bring me two crates."
msgstr ""
"El lino es más suave que la lana sobre la piel. ¡{crew|Siembra|Siembra|Sembrad} lino en "
"{crew|tu|tu|vuestra} granja! Cuando florezca azul y esté maduro, {crew|tráeme|tráeme|traedme} dos "
"cajas."

#. what a person says, at most 6 lines
#: data/missions/036_flax_in_the_field/mission.json
#, fuzzy
msgid "Flax seed in the field. In a few days, it blooms blue."
msgstr "Semilla de lino en el campo. Dentro de unos días florecerá azul."

#. what a person says, at most 6 lines
#: data/missions/036_flax_in_the_field/mission.json
#, fuzzy
msgid "Your own flax! I will make you linen shirts, soft as a cloud."
msgstr ""
"¡{crew|Tu propio|Tu propio|Vuestro propio} lino! {crew|Te|Te|Os} haré camisas de lino, suaves como"
" una nube."

#. a gift for a task: 'You get ...'
#: data/missions/036_flax_in_the_field/mission.json
#, fuzzy
msgid "linen shirts"
